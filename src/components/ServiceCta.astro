---
/**
 * The closing call to action shared by every service page. <ServiceDetail>
 * renders it by default; a page that needs something between the process grid
 * and the CTA — the software pages put the Cybromines credit there — passes
 * `cta={false}` to <ServiceDetail> and places this itself.
 */
import { site } from '../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
}

const {
  eyebrow = 'Ready when you are',
  title = "Tell us where your brand needs to go — we'll light the way.",
} = Astro.props;
---

<section class="cta">
  <div class="cta__inner" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="cta__title">{title}</h2>
    <div class="cta__actions">
      <a href="/contact" class="btn btn--flame">Start your project →</a>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn--ghost">
        Chat on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: clamp(72px, 9vw, 132px) var(--gutter);
    background: radial-gradient(120% 130% at 75% 18%, #3a1f1c 0%, #1c1d22 46%, #0f1012 100%);
    overflow: hidden;
  }

  .cta__inner {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .cta__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(18.5px, 2.9vw, 32.5px);
    line-height: 1.22;
    letter-spacing: -0.02em;
    margin: 0 0 36px;
    color: var(--ml-ink-hi);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
</style>
