---
/**
 * Placeholder for pages the source bundle linked to but did not ship content
 * for. Keeps navigation whole; delete each instance as the real page lands.
 */
import { site } from '../data/site';

interface Props {
  note: string;
}

const { note } = Astro.props;
---

<section class="pending">
  <div class="shell shell--narrow">
    <p class="eyebrow" data-reveal>Coming together</p>
    <p class="pending__note" data-reveal>{note}</p>
    <div class="pending__actions" data-reveal>
      <a href="/contact" class="btn btn--flame">Start your project →</a>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn--ghost">
        Chat on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .pending {
    padding-block: var(--section-y);
    background: var(--ml-bg-alt);
  }

  .pending__note {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: clamp(22px, 2.8vw, 34px);
    line-height: 1.35;
    color: var(--ml-ink);
    margin: 0 0 36px;
    max-width: 780px;
  }

  .pending__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
