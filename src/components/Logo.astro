---
/**
 * The Magic Lantern logo, converted 1:1 from `ML new Logo.ai` (artwork
 * untouched — flame mark + "ft. MAGIC LANTERN ENTERTAINMENTS" lockup).
 */
interface Props {
  /** Rendered height of the logo in px. */
  size?: number;
  class?: string;
}

const { size = 56, class: className } = Astro.props;
---

<img
  class:list={['logo', className]}
  src="/assets/ml-logo.svg"
  alt="ft. Magic Lantern Entertainments"
  style={`height: ${size}px`}
/>

<style>
  .logo {
    display: block;
    width: auto;
  }
</style>
