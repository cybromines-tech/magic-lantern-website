---
/**
 * Full logo lockup: flame mark + letterspaced "Magic Lantern" wordmark.
 * Rendered as markup rather than a flat SVG so the wordmark uses the real
 * Anton webfont and stays selectable/searchable.
 */
import LogoMark from './LogoMark.astro';

interface Props {
  /** Cap height of the mark in px; the wordmark scales from it. */
  size?: number;
  class?: string;
}

const { size = 38, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`--mark: ${size}px`}>
  <LogoMark class="logo__mark" fill="var(--ml-flame)" />
  <span class="logo__word">Magic Lantern</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--mark) * 0.3);
    color: var(--ml-ink);
  }

  /* :global — the mark is rendered by the child <LogoMark>, which this
     component's scope hash does not reach. */
  .logo :global(.logo__mark) {
    height: var(--mark);
    /* An explicit ratio — `width: auto` on an SVG in a flex row collapses. */
    aspect-ratio: 102.3 / 182.4;
    width: auto;
    flex: none;
    filter: drop-shadow(0 0 calc(var(--mark) * 0.35) rgba(224, 86, 74, 0.45));
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: calc(var(--mark) * 0.42);
    line-height: 1;
    letter-spacing: 0.24em;
    /* Optical correction: letter-spacing pads the right edge of the last glyph. */
    margin-right: -0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: currentColor;
  }
</style>
