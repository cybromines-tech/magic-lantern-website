---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const serviceDetails = [
  {
    num: '01',
    title: 'Branding',
    desc: "Magic Lantern provides top-notch branding solutions through expert video production, graphic design, digital marketing, and photoshoots. We create unique, compelling visuals that effectively communicate your brand's message and help you stand out.",
    href: '/service-branding',
    image: '/assets/services/branding.jpg',
  },
  {
    num: '02',
    title: 'Digital Marketing',
    desc: "Magic Lantern excels in digital marketing services, providing customized strategies to meet your specific needs. Our team focuses on SEO, social media marketing, content creation, and online advertising to boost your brand's visibility and engagement. We use data-driven insights to optimize campaigns, ensuring maximum reach and impact. Trust Magic Lantern to elevate your online presence and drive measurable results.",
    href: '/service-digital',
    image: '/assets/services/digital-marketing.jpg',
  },
  {
    num: '03',
    title: 'Website Development',
    desc: 'We provide comprehensive website development services, creating responsive, user-friendly sites that deliver a seamless user experience. Our team focuses on functionality, aesthetics, and performance to effectively represent your brand and engage your audience. From design to deployment, we offer end-to-end solutions for a strong online presence.',
    href: '/service-web',
    image: '/assets/services/website-development.jpg',
  },
  {
    num: '04',
    title: 'Video Production & Photoshoot',
    desc: 'Television Commercial, Corporate Video, Product Photography/Videography, Sales/Marketing Video, Scripted Video, Social Media Reels.',
    href: '/service-video',
    image: '/assets/services/video-production.jpg',
  },
];
---

<Base title="Services" description="Branding, digital marketing, websites, video and photography — end to end, in house." active="services">
  <PageHero eyebrow="What we do" title="Services" lede="Branding, digital marketing, websites, video and photography — end to end, in house." />

  <section class="serviceList">
    <div class="shell">
      {
        serviceDetails.map((s) => (
          <article class="serviceCard" data-reveal>
            <a href={s.href} class="serviceCard__media">
              <img src={s.image} alt={s.title} loading="lazy" decoding="async" />
            </a>
            <div class="serviceCard__body">
              <span class="serviceCard__num">{s.num}</span>
              <h2 class="serviceCard__title">{s.title}</h2>
              <p class="serviceCard__desc">{s.desc}</p>
              <a href={s.href} class="link-arrow">Learn more →</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .serviceList {
    padding-block: var(--section-y);
    background: var(--ml-bg);
  }

  .serviceList .shell {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .serviceCard {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: var(--ml-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s var(--ease-out), border-color 0.3s;
  }

  .serviceCard:hover {
    transform: translateY(-6px);
    border-color: rgba(224, 86, 74, 0.5);
  }

  .serviceCard__media {
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #d9d9d7;
    padding: 14px;
  }

  .serviceCard__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s var(--ease-out);
  }

  .serviceCard:hover .serviceCard__media img {
    transform: scale(1.04);
  }

  .serviceCard__body {
    padding: 30px 32px 34px;
  }

  .serviceCard__num {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ml-flame);
  }

  .serviceCard__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(14.5px, 1.6vw, 18.5px);
    line-height: 1.2;
    color: var(--ml-ink);
    margin: 10px 0 14px;
  }

  .serviceCard__desc {
    font-size: 11px;
    line-height: 1.7;
    color: var(--ml-muted);
    margin: 0 0 22px;
  }

  @media (max-width: 860px) {
    .serviceList .shell {
      grid-template-columns: 1fr;
    }
  }
</style>
