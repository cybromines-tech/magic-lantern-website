---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CybrominesLogo from '../components/CybrominesLogo.astro';
import { softwareServices } from '../data/software';

/* The creative four, with the long-form pitch and the artwork the software
   systems below deliberately do without. Their short lines live in
   `data/site.ts`; these are the paragraphs only this page has room for. */
const creativeDetails = [
  {
    num: '01',
    title: 'Branding',
    desc: "Magic Lantern provides top-notch branding solutions through expert video production, graphic design, digital marketing, and photoshoots. We create unique, compelling visuals that effectively communicate your brand's message and help you stand out.",
    href: '/service-branding',
    image: '/assets/services/branding.jpg',
  },
  {
    num: '02',
    title: 'Digital Marketing',
    desc: "Magic Lantern excels in digital marketing services, providing customised strategies to meet your specific needs. Our team focuses on SEO, social media marketing, content creation, and online advertising to boost your brand's visibility and engagement. We use data-driven insights to optimise campaigns, ensuring maximum reach and impact. Trust Magic Lantern to elevate your online presence and drive measurable results.",
    href: '/service-digital',
    image: '/assets/services/digital-marketing.jpg',
  },
  {
    num: '03',
    title: 'Website Development',
    desc: 'We provide comprehensive website development services, creating responsive, user-friendly sites that deliver a seamless user experience. Our team focuses on functionality, aesthetics, and performance to effectively represent your brand and engage your audience. From design to deployment, we offer end-to-end solutions for a strong online presence.',
    href: '/service-web',
    image: '/assets/services/website-development.jpg',
  },
  {
    num: '04',
    title: 'Video Production & Photoshoot',
    desc: 'Television Commercial, Corporate Video, Product Photography/Videography, Sales/Marketing Video, Scripted Video, Social Media Reels.',
    href: '/service-video',
    image: '/assets/services/video-production.jpg',
  },
];
---

<Base
  title="Services"
  description="Branding, marketing, websites, video and photography — plus the ERP, CRM, HRMS and POS systems that run the business underneath."
  active="services"
>
  <PageHero
    eyebrow="What we do"
    title="Services"
    lede="Two halves of one offer: the story that brings people to your door, and the systems that handle them once they arrive."
  />

  <!-- CREATIVE -->
  <section class="serviceList" id="creative">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>01 — Creative</p>
          <h2 class="display" data-reveal>The story, and<br />everything that carries it</h2>
        </div>
        <p class="sectionNote" data-reveal>
          Scripted, shot, designed and marketed in house — from the first idea to the
          final cut.
        </p>
      </div>

      <div class="serviceList__grid">
        {
          creativeDetails.map((s) => (
            <article class="serviceCard" data-reveal>
              <a href={s.href} class="serviceCard__media">
                <img src={s.image} alt={s.title} loading="lazy" decoding="async" />
              </a>
              <div class="serviceCard__body">
                <span class="serviceCard__num">{s.num}</span>
                <h3 class="serviceCard__title">{s.title}</h3>
                <p class="serviceCard__desc">{s.desc}</p>
                <a href={s.href} class="link-arrow">Learn more →</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOFTWARE -->
  <section class="systemList" id="software">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--cybro" data-reveal>02 — Software</p>
          <h2 class="display" data-reveal>The systems your<br />operation runs on</h2>
        </div>
        <p class="sectionNote" data-reveal>
          Sold and shaped by Magic Lantern, engineered by our development partner
          Cybromines. One brief, one team, no hand-off gap.
        </p>
      </div>

      <div class="systemList__grid">
        {
          softwareServices.map((s) => (
            <a href={`/software/${s.slug}`} class="systemCard" data-reveal>
              <span class="systemCard__num">{s.num}</span>
              <h3 class="systemCard__title">{s.title}</h3>
              <p class="systemCard__desc">{s.desc}</p>
              <span class="systemCard__more">Explore →</span>
            </a>
          ))
        }
      </div>

      <a href="/cybromines" class="partnerRow" data-reveal>
        <span class="partnerRow__label">Software development partner</span>
        <span class="partnerRow__rule" aria-hidden="true"></span>
        <CybrominesLogo size={26} uid="services" />
      </a>
    </div>
  </section>
</Base>

<style>
  /* --- Creative ------------------------------------------------------------ */

  .serviceList {
    padding-block: var(--section-y);
    background: var(--ml-bg);
  }

  .serviceList__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .sectionNote {
    max-width: 40ch;
    align-self: flex-end;
    font-size: 11px;
    line-height: 1.75;
    color: var(--ml-muted);
    margin: 0;
  }

  .serviceCard {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: var(--ml-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s var(--ease-out), border-color 0.3s;
  }

  .serviceCard:hover {
    transform: translateY(-6px);
    border-color: rgba(224, 86, 74, 0.5);
  }

  .serviceCard__media {
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #d9d9d7;
    padding: 14px;
  }

  .serviceCard__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s var(--ease-out);
  }

  .serviceCard:hover .serviceCard__media img {
    transform: scale(1.04);
  }

  .serviceCard__body {
    padding: 30px 32px 34px;
  }

  .serviceCard__num {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ml-flame);
  }

  .serviceCard__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(14.5px, 1.6vw, 18.5px);
    line-height: 1.2;
    color: var(--ml-ink);
    margin: 10px 0 14px;
  }

  .serviceCard__desc {
    font-size: 11px;
    line-height: 1.7;
    color: var(--ml-muted);
    margin: 0 0 22px;
  }

  /* --- Software ------------------------------------------------------------ */

  /* The violet marks the systems as partner-built without restyling the whole
     section into Cybromines' palette. */
  .systemList {
    padding-block: var(--section-y);
    background: var(--ml-bg-alt);
    border-top: 1px solid var(--ml-line);
  }

  .eyebrow--cybro {
    color: #b7a9e0;
  }

  .systemList__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(268px, 1fr));
    gap: 18px;
  }

  .systemCard {
    display: flex;
    flex-direction: column;
    min-height: 210px;
    padding: 26px 26px 24px;
    border-radius: 16px;
    background: var(--ml-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s var(--ease-out), border-color 0.3s, background 0.3s;
  }

  .systemCard:hover {
    transform: translateY(-5px);
    border-color: rgba(124, 58, 237, 0.45);
    background: var(--ml-surface-hi);
  }

  .systemCard__num {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1;
    color: rgba(167, 139, 250, 0.34);
  }

  .systemCard__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.25;
    color: var(--ml-ink);
    margin: 16px 0 10px;
  }

  .systemCard__desc {
    flex: 1;
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--ml-muted);
    margin: 0 0 18px;
  }

  .systemCard__more {
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 10.5px;
    color: #b7a9e0;
  }

  .partnerRow {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(34px, 4vw, 54px);
    color: var(--ml-dim);
    transition: color 0.2s;
  }

  .partnerRow:hover {
    color: var(--ml-ink);
  }

  .partnerRow__label {
    font-family: var(--font-caps);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: inherit;
  }

  .partnerRow__rule {
    width: clamp(28px, 5vw, 60px);
    height: 1px;
    background: var(--ml-line-strong);
  }

  @media (max-width: 860px) {
    .serviceList__grid {
      grid-template-columns: 1fr;
    }

    .sectionNote {
      align-self: flex-start;
    }
  }
</style>
