---
import Base from '../layouts/Base.astro';
import MLScene from '../components/MLScene.astro';
import CybrominesLogo from '../components/CybrominesLogo.astro';
import { services, site } from '../data/site';
import { cybromines } from '../data/cybromines';

const marqueeWords = [
  'Video Production',
  'Branding',
  'Digital Marketing',
  'Website Development',
  'Photoshoots',
  'Social Reels',
];
/* Doubled so the -50% keyframe loops seamlessly. */
const marquee = [...marqueeWords, ...marqueeWords];

const stats = [
  { value: 120, suffix: '+', label: 'Projects delivered' },
  { value: 48, suffix: '+', label: 'Brands illuminated' },
  { value: 300, suffix: '+', label: 'Films & reels shot' },
  { value: 100, suffix: '%', label: 'In-house, start to end' },
];

const steps = [
  { step: 'STEP 01', title: 'Discover', desc: 'We dig into your brand, audience and goals to find the story worth telling.' },
  { step: 'STEP 02', title: 'Strategy', desc: 'A clear plan — channels, messaging and a creative direction that fits.' },
  { step: 'STEP 03', title: 'Create', desc: 'Scripting, shooting, design and edit — crafted in-house, obsessively.' },
  { step: 'STEP 04', title: 'Launch', desc: 'We publish, promote and put your work in front of the right people.' },
  { step: 'STEP 05', title: 'Grow', desc: 'We measure, optimise and keep the momentum building month on month.' },
];

const reels = [
  {
    tag: 'Social Reels',
    title: 'Every Brand Has a Soul',
    href: 'https://www.instagram.com/reel/Daavj7ZvLgd/?igsh=cDk1dnNtbXQ2ejVi',
    preview: '/assets/reels/brand-film-preview.mp4',
    full: '/assets/reels/brand-film.mp4',
    poster: '/assets/reels/brand-film-poster.jpg',
    aspect: 'landscape',
  },
  {
    tag: 'Video Production',
    title: 'Le Client',
    href: 'https://www.instagram.com/reel/DAtPFqShxuw/?igsh=MXQ5ZDFjc2sxcWN2ZA==',
    preview: '/assets/reels/le-client-preview.mp4',
    full: '/assets/reels/le-client.mp4',
    poster: '/assets/reels/le-client-poster.jpg',
    aspect: 'portrait',
  },
];

const work = [
  { tag: 'Product Shoot', title: 'Studio Photography', src: '/assets/covers/cover-photo.svg' },
];
---

<Base title={site.name} active="home">
  <!-- HERO -->
  <section class="hero">
    <MLScene variant="hero" />
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__badge heroIn">
          <span class="hero__pulse" aria-hidden="true"></span>{site.tagline}
        </p>

        <h1 class="hero__title heroIn">
          <span class="hero__caps">Lights. Camera.</span><br />
          {/* The animated words are decorative; the visually-hidden span gives
              screen readers one stable headline. */}
          <span class="hero__rotate" data-rotate aria-hidden="true">
            <span class="hero__word is-active">Growth.</span>
            <span class="hero__word">Magic.</span>
            <span class="hero__word">Stories.</span>
            <span class="hero__word">Impact.</span>
          </span>
          <span class="visually-hidden">Growth.</span>
        </h1>

        <p class="hero__lede lede heroIn">{site.description} One team, start to end.</p>

        <div class="hero__actions heroIn">
          <a href="/contact" class="btn btn--flame">Start your project →</a>
          <a href="/portfolio" class="btn btn--ghost">▶ Watch our work</a>
        </div>

        <a href="/cybromines" class="partner heroIn">
          <span class="partner__label">Software development partner</span>
          <span class="partner__rule" aria-hidden="true"></span>
          <CybrominesLogo size={24} uid="hero" />
        </a>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      Scroll
      <span class="hero__mouse"><span class="hero__wheel"></span></span>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee">
    <div class="marquee__track" aria-hidden="true" data-animate-in-view>
      {
        marquee.map((word, i) => (
          <span class="marquee__item">
            <span class:list={['marquee__word', i % 2 === 1 && 'marquee__word--outline']}>
              {word}
            </span>
            <span class="marquee__diamond" />
          </span>
        ))
      }
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro">
    <div class="shell shell--narrow">
      <p class="eyebrow" data-reveal>From idea to impact</p>
      <p class="intro__statement" data-reveal>
        We believe in the power of storytelling to transform perspectives and connect people.
        Every frame, every headline, every pixel is built to make audiences
        <span>stop, watch and remember.</span>
      </p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>What we do</p>
          <h2 class="display" data-reveal>Four ways we<br />light up brands</h2>
        </div>
        <a href="/services" class="link-arrow" data-reveal>All services →</a>
      </div>

      <div class="services__grid">
        {
          services.map((s) => (
            <a href={s.href} class="card" data-reveal>
              <span class="card__num">{s.num}</span>
              <span class="card__body">
                <span class="card__title">{s.title}</span>
                <span class="card__desc">{s.desc}</span>
              </span>
              <span class="card__more">Explore →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="shell shell--narrow stats__grid">
      {
        stats.map((st) => (
          <div class="stat" data-reveal>
            <span class="stat__value" data-count={`${st.value}${st.suffix}`}>0{st.suffix}</span>
            <span class="stat__label">{st.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- DEVELOPMENT PARTNER -->
  <section class="partnerFeature">
    <div class="shell partnerFeature__grid">
      <a href="/cybromines" class="partnerFeature__logo" data-reveal>
        <img
          src="/assets/cybromines-logo.png"
          alt="Cybromines — Invention is our Innovation"
          width="543"
          height="405"
          loading="lazy"
          decoding="async"
        />
      </a>

      <div class="partnerFeature__copy">
        <p class="eyebrow" data-reveal>Our software development partner</p>
        <h2 class="display" data-reveal>Software by<br />Cybromines</h2>
        <p class="partnerFeature__desc" data-reveal>{cybromines.relationship}</p>
        <a href="/cybromines" class="link-arrow" data-reveal>Meet Cybromines →</a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process">
    <div class="shell">
      <p class="eyebrow" data-reveal>Start to end</p>
      <h2 class="display process__title" data-reveal>One team, every step</h2>

      <ol class="process__grid">
        {
          steps.map((p) => (
            <li class="step" data-reveal>
              <span class="step__num">{p.step}</span>
              <h3 class="step__title">{p.title}</h3>
              <p class="step__desc">{p.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- WORK -->
  <section class="work">
    <div class="shell">
      <div class="section-head work__head">
        <h2 class="display" data-reveal>Recent work</h2>
        <a href="/portfolio" class="link-arrow" data-reveal>View portfolio →</a>
      </div>

      <div class="work__grid">
        {
          reels.map((r) => (
            <button
              type="button"
              class="tile tile--video"
              data-reveal
              data-reel-open
              data-full={r.full}
              data-poster={r.poster}
              data-href={r.href}
              data-aspect={r.aspect}
              data-tag={r.tag}
              data-title={r.title}
            >
              <video
                class="tile__img"
                src={r.preview}
                poster={r.poster}
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              />
              <span class="tile__scrim" aria-hidden="true" />
              <span class="tile__play" aria-hidden="true">▶</span>
              <span class="tile__meta">
                <span class="tile__tag">{r.tag}</span>
                <span class="tile__title">{r.title}</span>
              </span>
              <span class="visually-hidden">Play reel with sound</span>
            </button>
          ))
        }
        {
          work.map((w) => (
            <a href="/portfolio" class="tile" data-reveal>
              <img class="tile__img" src={w.src} alt="" loading="lazy" decoding="async" />
              <span class="tile__scrim" aria-hidden="true" />
              <span class="tile__meta">
                <span class="tile__tag">{w.tag}</span>
                <span class="tile__title">{w.title}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="reelModal" data-reel-modal hidden>
      <div class="reelModal__backdrop" data-reel-close></div>
      <div class="reelModal__dialog" role="dialog" aria-modal="true" aria-label="Reel player">
        <button type="button" class="reelModal__close" data-reel-close aria-label="Close">&times;</button>
        <video class="reelModal__video" controls playsinline preload="none"></video>
        <div class="reelModal__foot">
          <div class="reelModal__info">
            <span class="tile__tag" data-reel-tag></span>
            <span class="reelModal__title" data-reel-title></span>
          </div>
          <a href="#" target="_blank" rel="noopener" class="btn btn--flame reelModal__cta" data-reel-link>
            View on Instagram ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta__inner" data-reveal>
      <p class="cta__script">ready when you are</p>
      <h2 class="cta__title">Let&rsquo;s make something<br />worth watching</h2>
      <div class="cta__actions">
        <a href="/contact" class="btn btn--light">Start a project</a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn--outline-light">
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Reel tile + modal. This bundled script evaluates once per session, so all
   * page-specific wiring happens inside `astro:page-load`, which fires on the
   * first load and after every client-side navigation. Document-level
   * listeners are registered once and look up the current DOM when they fire.
   */

  let previewObserver: IntersectionObserver | null = null;

  function reelModal(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-reel-modal]');
  }

  function previews(): HTMLVideoElement[] {
    return Array.from(document.querySelectorAll<HTMLVideoElement>('[data-reel-open] video'));
  }

  /* Resumes only the previews that are actually in the viewport. */
  function resumePreviews() {
    for (const video of previews()) {
      const rect = video.getBoundingClientRect();
      if (rect.bottom > 0 && rect.top < window.innerHeight) video.play().catch(() => {});
    }
  }

  function closeReel() {
    const modal = reelModal();
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    document.documentElement.style.removeProperty('overflow');
    modal.querySelector<HTMLVideoElement>('video')?.pause();
    resumePreviews();
  }

  function openReel(tile: HTMLElement) {
    const modal = reelModal();
    if (!modal) return;
    const full = modal.querySelector<HTMLVideoElement>('video');
    if (!full) return;

    const { full: src, poster, href, aspect, tag, title } = tile.dataset;
    modal.querySelector('[data-reel-tag]')!.textContent = tag ?? '';
    modal.querySelector('[data-reel-title]')!.textContent = title ?? '';
    modal.querySelector<HTMLAnchorElement>('[data-reel-link]')!.href = href ?? '#';
    modal
      .querySelector('.reelModal__dialog')!
      .classList.toggle('reelModal__dialog--portrait', aspect === 'portrait');

    if (full.getAttribute('src') !== src) {
      full.src = src ?? '';
      full.poster = poster ?? '';
    }

    modal.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    previews().forEach((v) => v.pause());

    full.currentTime = 0;
    full.muted = false;
    full.volume = 1;
    full.play().catch(() => {
      /* If the browser refuses sound-on playback, the controls are visible
         and one tap starts it. */
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const tile = target?.closest?.('[data-reel-open]') as HTMLElement | null;
    if (tile) openReel(tile);
    else if (target?.closest?.('[data-reel-close]')) closeReel();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeReel();
  });

  document.addEventListener('astro:page-load', () => {
    const items = previews();
    if (!items.length) return;

    /* Muted inline previews only run while their tile is actually on screen. */
    previewObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && reelModal()?.hidden !== false) video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.25 }
    );
    items.forEach((v) => previewObserver!.observe(v));
  });

  document.addEventListener('astro:before-swap', () => {
    previewObserver?.disconnect();
    previewObserver = null;
    /* The modal (and its scroll lock) must not survive into the next page. */
    closeReel();
  });
</script>

<style>
  /* --- Hero --------------------------------------------------------------- */

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(130% 100% at 72% 24%, #3a1f1c 0%, #1c1d22 44%, #0f1012 100%);
  }

  /* Darkens the lower-left so hero copy keeps contrast over the WebGL embers. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 30% 60%, rgba(15, 16, 18, 0.72), transparent 70%);
    pointer-events: none;
  }

  /* Full-bleed, not shell-capped: the copy starts at the left gutter and the
     scene owns the right half, so wide screens read as filled edge to edge.
     Vertical padding is viewport-relative so the partner row fits without
     pushing the scroll cue off screen on shorter laptops. The nav is 76px,
     hence the top floor. */
  .hero__inner {
    position: relative;
    width: 100%;
    /* The copy shouldn't hug the viewport edge: indent it a touch toward the
       centre on wide screens, while narrow screens keep the plain gutter. */
    padding-inline: max(var(--gutter), 6vw) var(--gutter);
    padding-block: clamp(96px, 11vh, 124px) clamp(52px, 7vh, 82px);
    pointer-events: none; /* Let the pointer reach the scene; buttons opt back in. */
  }

  /* The monogram centres itself in its canvas, so pinning the canvas to the
     right half puts it in the middle of that half — clear of the copy. Below
     900px the copy spans the full width again and the scene goes back to being
     a full-bleed backdrop behind it. */
  .hero :global(.ml-scene) {
    inset: 0 0 0 auto;
    width: 52%;
    /* The scene's warm haze would otherwise end in a hard vertical line at the
       canvas edge; feather it into the hero background instead. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 24%);
    mask-image: linear-gradient(90deg, transparent, #000 24%);
  }

  @media (max-width: 900px) {
    .hero :global(.ml-scene) {
      inset: 0;
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  .hero__copy {
    max-width: 820px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 30px;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(178, 35, 25, 0.14);
    border: 1px solid rgba(224, 86, 74, 0.32);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ml-blush);
  }

  .hero__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ml-flame);
    animation: mlPulse 2.4s infinite;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(52px, 9.4vw, 140px);
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
    color: var(--ml-ink-hi);
    text-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  /* A slow spotlight glint sweeps across the caps — lantern light passing
     over marquee lettering. The base position shows the plain ink colour, so
     with animations disabled the line simply reads white. */
  .hero__caps {
    color: transparent;
    background-image: linear-gradient(
      105deg,
      var(--ml-ink-hi) 0%,
      var(--ml-ink-hi) 40%,
      #ffd9c4 47%,
      #ffffff 50%,
      #ffd9c4 53%,
      var(--ml-ink-hi) 60%,
      var(--ml-ink-hi) 100%
    );
    background-size: 320% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    animation: mlShine 5.6s ease-in-out 1.2s infinite;
  }

  @keyframes mlShine {
    /* Long hold, then one pass — a glint, not a strobe. */
    0%,
    52% {
      background-position: 100% 0;
    }
    100% {
      background-position: 0% 0;
    }
  }

  /* The payoff word abandons the uppercase system: a sweeping fashion italic
     against the towering caps is the one deliberate glamour moment. The stack
     is an inline grid so every word occupies the same slot and the layout
     never jumps as they trade places. */
  .hero__rotate {
    display: inline-grid;
    white-space: nowrap;
  }

  .hero__word {
    grid-area: 1 / 1;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ml-flame);
    opacity: 0;
    transform: translateY(0.3em);
    filter: blur(7px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .hero__word.is-active {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .hero__word.is-leaving {
    opacity: 0;
    transform: translateY(-0.3em);
    filter: blur(7px);
  }

  .hero__lede {
    max-width: 600px;
    margin: 28px 0 40px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    pointer-events: auto;
  }

  /* Staggered entrance for the hero stack. */
  .heroIn {
    opacity: 0;
    animation: mlUp 0.9s var(--ease-out) forwards;
  }

  .hero__title.heroIn {
    animation-delay: 0.08s;
  }

  .hero__lede.heroIn {
    animation-delay: 0.16s;
  }

  .hero__actions.heroIn {
    animation-delay: 0.24s;
  }

  /* Partner credit. Deliberately quiet — it sits below the calls to action and
     must not compete with them for attention. */
  .partner {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(22px, 3.2vh, 38px);
    padding: 8px 18px 8px 0;
    border-radius: 999px;
    pointer-events: auto;
    color: var(--ml-muted);
    transition: color 0.2s, opacity 0.2s;
  }

  .partner:hover {
    color: var(--ml-ink);
  }

  .partner__label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
  }

  .partner__rule {
    width: clamp(20px, 4vw, 46px);
    height: 1px;
    flex: none;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.22), rgba(124, 58, 237, 0.6));
  }

  .partner.heroIn {
    animation-delay: 0.32s;
  }

  @media (max-width: 520px) {
    .partner {
      gap: 12px;
      margin-top: 26px;
    }

    .partner__label {
      font-size: 10.5px;
      letter-spacing: 0.12em;
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #8b8c90;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 14px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hero__wheel {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--ml-flame);
    animation: mlDot 1.8s infinite;
  }

  /* Short laptops: the display type is sized off viewport *width*, so on a wide
     but shallow screen the hero stack overflows and pushes the scroll cue below
     the fold. Tighten the vertical rhythm rather than let it spill. */
  @media (min-width: 940px) and (max-height: 800px) {
    .hero__inner {
      padding-block: 88px 44px;
    }

    .hero__title {
      font-size: clamp(40px, 6vw, 92px);
    }

    .hero__badge {
      margin-bottom: 20px;
    }

    .hero__lede {
      margin: 20px 0 28px;
    }

    .partner {
      margin-top: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .heroIn {
      opacity: 1;
      animation: none;
    }
  }

  /* --- Marquee ------------------------------------------------------------ */

  .marquee {
    position: relative;
    overflow: hidden;
    background: var(--ml-bg);
    border-top: 1px solid var(--ml-line-soft);
    border-bottom: 1px solid var(--ml-line-soft);
    padding: 26px 0;
  }

  /* `will-change` is applied by pauseOffscreenAnimations() only while the
     track is on screen — left on permanently it pins a very wide layer in
     GPU memory for the whole page. */
  .marquee__track {
    display: flex;
    width: max-content;
    animation: mlMarquee 32s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    padding: 0 clamp(14px, 2vw, 28px);
  }

  .marquee__word {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 50px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ml-ink);
    white-space: nowrap;
  }

  /* Alternating words are knocked out to an outline for rhythm. */
  .marquee__word--outline {
    color: transparent;
    -webkit-text-stroke: 1.2px var(--ml-red);
  }

  .marquee__diamond {
    width: 12px;
    height: 12px;
    flex: none;
    transform: rotate(45deg);
    background: var(--ml-red);
  }

  /* --- Intro -------------------------------------------------------------- */

  .intro {
    position: relative;
