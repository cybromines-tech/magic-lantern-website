---
import Base from '../layouts/Base.astro';
import MLScene from '../components/MLScene.astro';
import CybrominesLogo from '../components/CybrominesLogo.astro';
import VideoTile from '../components/VideoTile.astro';
import ReelModal from '../components/ReelModal.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, site } from '../data/site';
import { socialAds } from '../data/work';

const marqueeWords = [
  'Video Production',
  'Branding',
  'Digital Marketing',
  'Website Development',
  'Photoshoots',
  'Social Reels',
];
/* Doubled so the -50% keyframe loops seamlessly. */
const marquee = [...marqueeWords, ...marqueeWords];

const stats = [
  { value: 120, suffix: '+', label: 'Projects delivered' },
  { value: 48, suffix: '+', label: 'Brands illuminated' },
  { value: 300, suffix: '+', label: 'Films & reels shot' },
  { value: 100, suffix: '%', label: 'In-house, start to end' },
];

const steps = [
  { step: 'STEP 01', title: 'Discover', desc: 'We dig into your brand, audience and goals to find the story worth telling.' },
  { step: 'STEP 02', title: 'Strategy', desc: 'A clear plan — channels, messaging and a creative direction that fits.' },
  { step: 'STEP 03', title: 'Create', desc: 'Scripting, shooting, design and edit — crafted in-house, obsessively.' },
  { step: 'STEP 04', title: 'Launch', desc: 'We publish, promote and put your work in front of the right people.' },
  { step: 'STEP 05', title: 'Grow', desc: 'We measure, optimise and keep the momentum building month on month.' },
];

/* PUPA × Magic Lantern slider.
   Photos are the carousel from the Instagram post below (Pupa Season 20).
   To add videos later, append `type: 'video'` slides with the same fields as
   the reels above — they plug into the existing reel modal automatically:
   { type: 'video', title: 'Workshop film',
     preview: '/assets/pupa/xxx-preview.mp4', full: '/assets/pupa/xxx.mp4',
     poster: '/assets/pupa/xxx-poster.jpg', href: 'https://instagram.com/…',
     aspect: 'landscape' } */
const pupaPost = 'https://www.instagram.com/p/DQBPkU2gWqm/';

type PupaItem = {
  type: 'photo' | 'video';
  title: string;
  src?: string;
  preview?: string;
  full?: string;
  poster?: string;
  href?: string;
  aspect?: 'landscape' | 'portrait';
};

const pupaGallery: PupaItem[] = Array.from({ length: 11 }, (_, i) => ({
  type: 'photo',
  title: `Pupa Season 20 at Giby Farm, Thrissur — moment ${i + 1}`,
  src: `/assets/pupa/pupa-${String(i + 1).padStart(2, '0')}.jpg`,
}));

const pupaFacts = [
  { label: 'Led by', value: 'Tharun Moorthy — director of Operation Java, Saudi Vellakka & Thudarum' },
  { label: 'Powered by', value: 'Elephant Tales, his Kochi-based creative studio' },
  { label: 'Our chapter', value: 'Pupa Season 20 · Giby Farm, Thrissur' },
];

/* Three reel slots under the photo slider. Slots without a local preview/full/
   poster set yet just link out to Instagram; once those files land in
   /assets/pupa/, swap the slot to the same shape as `reels` above and it will
   open in the in-page reel modal instead. */
type PupaReel = {
  title: string;
  tag: string;
  href: string;
  preview?: string;
  full?: string;
  poster?: string;
  aspect?: 'landscape' | 'portrait';
};

const pupaReels: (PupaReel | null)[] = [
  {
    title: 'Pupa Season 20 — highlight reel',
    tag: 'Instagram Reel',
    href: 'https://www.instagram.com/reel/DPskLN5jDaY/?igsh=MTN5OWRkZGF6bW5kYg==',
    preview: '/assets/pupa/reel-01-preview.mp4',
    full: '/assets/pupa/reel-01.mp4',
    poster: '/assets/pupa/reel-01-poster.jpg',
    aspect: 'portrait',
  },
  {
    title: 'Pupa Season 20 — the room reacts',
    tag: 'Instagram Reel',
    href: pupaPost,
    preview: '/assets/pupa/reel-02-preview.mp4',
    full: '/assets/pupa/reel-02.mp4',
    poster: '/assets/pupa/reel-02-poster.jpg',
    aspect: 'portrait',
  },
  {
    title: 'Pupa Season 20 — into character',
    tag: 'Instagram Reel',
    href: pupaPost,
    preview: '/assets/pupa/reel-03-preview.mp4',
    full: '/assets/pupa/reel-03.mp4',
    poster: '/assets/pupa/reel-03-poster.jpg',
    aspect: 'portrait',
  },
];
---

<Base title={site.name} active="home">
  <!-- HERO -->
  <section class="hero">
    <MLScene variant="hero" />
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__badge heroIn">
          <span class="hero__pulse" aria-hidden="true"></span>{site.tagline}
        </p>

        <h1 class="hero__title heroIn">
          <span class="hero__caps">Lights. Camera.</span><br />
          {/* The animated words are decorative; the visually-hidden span gives
              screen readers one stable headline. */}
          <span class="hero__rotate" data-rotate aria-hidden="true">
            <span class="hero__word is-active">Growth.</span>
            <span class="hero__word">Magic.</span>
            <span class="hero__word">Stories.</span>
            <span class="hero__word">Impact.</span>
          </span>
          <span class="visually-hidden">Growth.</span>
        </h1>

        <p class="hero__lede lede heroIn">{site.description} One team, start to end.</p>

        <div class="hero__actions heroIn">
          <a href="/contact" class="btn btn--flame">Start your project →</a>
          <a href="/portfolio" class="btn btn--ghost">▶ Watch our work</a>
        </div>

        <a href="/cybromines" class="partner heroIn">
          <span class="partner__label">Software development partner</span>
          <span class="partner__rule" aria-hidden="true"></span>
          <CybrominesLogo size={24} uid="hero" />
        </a>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      Scroll
      <span class="hero__mouse"><span class="hero__wheel"></span></span>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee">
    <div class="marquee__track" aria-hidden="true" data-animate-in-view>
      {
        marquee.map((word, i) => (
          <span class="marquee__item">
            <span class:list={['marquee__word', i % 2 === 1 && 'marquee__word--outline']}>
              {word}
            </span>
            <span class="marquee__diamond" />
          </span>
        ))
      }
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro">
    <div class="shell shell--narrow">
      <p class="eyebrow" data-reveal>From idea to impact</p>
      <p class="intro__statement" data-reveal>
        We believe in the power of storytelling to transform perspectives and connect people.
        Every frame, every headline, every pixel is built to make audiences
        <span>stop, watch and remember.</span>
      </p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>What we do</p>
          <h2 class="display" data-reveal>Four ways we<br />light up brands</h2>
        </div>
        <a href="/services" class="link-arrow" data-reveal>All services →</a>
      </div>

      <div class="services__grid">
        {
          services.map((s) => (
            <a href={s.href} class="card" data-reveal>
              <span class="card__num">{s.num}</span>
              <span class="card__body">
                <span class="card__title">{s.title}</span>
                <span class="card__desc">{s.desc}</span>
              </span>
              <span class="card__more">Explore →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PUPA × MAGIC LANTERN -->
  <section class="pupa">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>Collaboration</p>
          <h2 class="display" data-reveal>Pupa &times;<br />Magic Lantern</h2>
        </div>
        <a href={pupaPost} target="_blank" rel="noopener" class="link-arrow" data-reveal>
          See it on Instagram ↗
        </a>
      </div>

      <div class="pupa__intro">
        <p class="pupa__desc" data-reveal>
          PUPA is the celebrated acting workshop founded by film director
          <strong>Tharun Moorthy</strong> and his creative studio Elephant Tales — a gathering
          where aspiring actors train, break open and become. Over twenty of its alumni walked
          straight into <em>Thudarum</em>. Magic Lantern collaborated with PUPA to conduct its
          Thrissur chapter at Giby Farm, and we captured every frame of it.
        </p>

        <ul class="pupa__facts" data-reveal>
          {
            pupaFacts.map((f) => (
              <li class="pupa__fact">
                <span class="pupa__factLabel">{f.label}</span>
                <span class="pupa__factValue">{f.value}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pupa__slider" data-pupa-slider data-reveal>
        <button type="button" class="pupa__nav pupa__nav--prev" data-pupa-prev aria-label="Previous photo">
          ←
        </button>

        <div class="pupa__track" data-pupa-track tabindex="0" aria-label="Pupa Season 20 photo slider">
          {
            pupaGallery.map((g) =>
              g.type === 'video' ? (
                <button
                  type="button"
                  class="tile tile--video pupa__slide"
                  data-reel-open
                  data-full={g.full}
                  data-poster={g.poster}
                  data-href={g.href}
                  data-aspect={g.aspect}
                  data-tag="Pupa Season 20"
                  data-title={g.title}
                >
                  <video
                    class="tile__img"
                    src={g.preview}
                    poster={g.poster}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  />
                  <span class="tile__scrim" aria-hidden="true" />
                  <span class="tile__play" aria-hidden="true">▶</span>
                  <span class="visually-hidden">Play video with sound</span>
                </button>
              ) : (
                <figure class="tile pupa__slide">
                  <img class="tile__img" src={g.src} alt={g.title} loading="lazy" decoding="async" />
                </figure>
              )
            )
          }
        </div>

        <button type="button" class="pupa__nav pupa__nav--next" data-pupa-next aria-label="Next photo">
          →
        </button>
      </div>

      <p class="eyebrow pupa__reelsEyebrow" data-reveal>On set</p>
      <div class="pupa__reels" data-reveal>
        {
          pupaReels.map((r) =>
            r ? (
              r.preview && r.full && r.poster ? (
                <button
                  type="button"
                  class="tile tile--video"
                  data-reel-open
                  data-full={r.full}
                  data-poster={r.poster}
                  data-href={r.href}
                  data-aspect={r.aspect ?? 'landscape'}
                  data-tag={r.tag}
                  data-title={r.title}
                >
                  <video
                    class="tile__img"
                    src={r.preview}
                    poster={r.poster}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  />
                  <span class="tile__scrim" aria-hidden="true" />
                  <span class="tile__play" aria-hidden="true">▶</span>
                  <span class="visually-hidden">Play video with sound</span>
                </button>
              ) : (
                <a href={r.href} target="_blank" rel="noopener" class="tile tile--video-link">
                  <span class="tile__reelIcon" aria-hidden="true">▶</span>
                  <span class="tile__meta">
                    <span class="tile__tag">{r.tag}</span>
                    <span class="tile__title">{r.title}</span>
                  </span>
                  <span class="visually-hidden">Opens on Instagram</span>
                </a>
              )
            ) : (
              <div class="tile tile--pending">Video coming soon</div>
            )
          )
        }
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="shell shell--narrow stats__grid">
      {
        stats.map((st) => (
          <div class="stat" data-reveal>
            <span class="stat__value" data-count={`${st.value}${st.suffix}`}>0{st.suffix}</span>
            <span class="stat__label">{st.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process">
    <div class="shell">
      <p class="eyebrow" data-reveal>Start to end</p>
      <h2 class="display process__title" data-reveal>One team, every step</h2>

      <ol class="process__grid">
        {
          steps.map((p) => (
            <li class="step" data-reveal>
              <span class="step__num">{p.step}</span>
              <h3 class="step__title">{p.title}</h3>
              <p class="step__desc">{p.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- WORK -->
  <section class="work">
    <div class="shell">
      <div class="section-head work__head">
        <h2 class="display" data-reveal>Recent work</h2>
        <a href="/portfolio" class="link-arrow" data-reveal>View portfolio →</a>
      </div>

      <div class="work__grid">
        {
          /* Cap to 3 — the full set lives on the Work page. */
          socialAds.slice(0, 3).map((item) => <VideoTile item={item} mode="preview" />)
        }
      </div>
    </div>

    <ReelModal />
  </section>

  <CtaBand lines={['Let’s make something', 'worth watching']} />
</Base>

<script>
  /**
   * Pupa slider. This bundled script evaluates once per session, so all
   * page-specific wiring happens inside `astro:page-load`, which fires on the
   * first load and after every client-side navigation. Document-level
   * listeners are registered once and look up the current DOM when they fire.
   *
   * The reel tiles and their modal are wired globally in `scripts/site.ts`.
   */

  let pupaAutoTimer: ReturnType<typeof setInterval> | null = null;
  let pupaResumeTimer: ReturnType<typeof setTimeout> | null = null;

  /* Pupa slider arrows: scroll the snap track by one slide. */
  function slidePupa(button: Element, dir: number) {
    const track = button
      .closest('[data-pupa-slider]')
      ?.querySelector<HTMLElement>('[data-pupa-track]');
    const slide = track?.querySelector<HTMLElement>('.pupa__slide');
    if (!track || !slide) return;
    const step = slide.offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0);
    /* Absolute target from the nearest slide index, so rapid clicks accumulate
       cleanly instead of compounding mid-animation offsets. */
    const index = Math.round(track.scrollLeft / step) + dir;
    track.scrollTo({ left: index * step, behavior: 'smooth' });
  }

  /* Pupa slider autoplay: advance one slide at a time, looping back to the
     start once the track bottoms out. Paused on any user interaction and
     resumed a few seconds after it ends, so it never fights a manual scroll. */
  function pupaTrack(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-pupa-track]');
  }

  function advancePupa() {
    const track = pupaTrack();
    const slide = track?.querySelector<HTMLElement>('.pupa__slide');
    if (!track || !slide) return;
    const step = slide.offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0);
    const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - step / 2;
    track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + step, behavior: 'smooth' });
  }

  function startPupaAuto() {
    if (pupaAutoTimer || !pupaTrack()) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    pupaAutoTimer = setInterval(advancePupa, 3200);
  }

  function stopPupaAuto() {
    if (!pupaAutoTimer) return;
    clearInterval(pupaAutoTimer);
    pupaAutoTimer = null;
  }

  /* Stop immediately, then restart after a breather once interaction settles. */
  function pausePupaAuto() {
    stopPupaAuto();
    if (pupaResumeTimer) clearTimeout(pupaResumeTimer);
    pupaResumeTimer = setTimeout(startPupaAuto, 4000);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const prev = target?.closest?.('[data-pupa-prev]');
    const next = target?.closest?.('[data-pupa-next]');
    if (prev) {
      pausePupaAuto();
      slidePupa(prev, -1);
    } else if (next) {
      pausePupaAuto();
      slidePupa(next, 1);
    }
  });

  document.addEventListener('astro:page-load', () => {
    const pupaSlider = document.querySelector<HTMLElement>('[data-pupa-slider]');
    if (!pupaSlider) return;
    pupaSlider.addEventListener('pointerenter', stopPupaAuto);
    pupaSlider.addEventListener('pointerleave', startPupaAuto);
    pupaSlider.addEventListener('touchstart', pausePupaAuto, { passive: true });
    pupaSlider.addEventListener('wheel', pausePupaAuto, { passive: true });
    startPupaAuto();
  });

  document.addEventListener('astro:before-swap', () => {
    stopPupaAuto();
    if (pupaResumeTimer) {
      clearTimeout(pupaResumeTimer);
      pupaResumeTimer = null;
    }
  });
</script>

<style>
  /* --- Hero --------------------------------------------------------------- */

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(130% 100% at 72% 24%, #3a1f1c 0%, #1c1d22 44%, #0f1012 100%);
  }

  /* Darkens the lower-left so hero copy keeps contrast over the WebGL embers. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 30% 60%, rgba(15, 16, 18, 0.72), transparent 70%);
    pointer-events: none;
  }

  /* Full-bleed, not shell-capped: the copy starts at the left gutter and the
     scene owns the right half, so wide screens read as filled edge to edge.
     Vertical padding is viewport-relative so the partner row fits without
     pushing the scroll cue off screen on shorter laptops. The nav is 76px,
     hence the top floor. */
  .hero__inner {
    position: relative;
    width: 100%;
    /* The copy shouldn't hug the viewport edge: indent it a touch toward the
       centre on wide screens, while narrow screens keep the plain gutter. */
    padding-inline: max(var(--gutter), 6vw) var(--gutter);
    padding-block: clamp(96px, 11vh, 124px) clamp(52px, 7vh, 82px);
    pointer-events: none; /* Let the pointer reach the scene; buttons opt back in. */
  }

  /* The monogram centres itself in its canvas, so pinning the canvas to the
     right half puts it in the middle of that half — clear of the copy. Below
     900px the copy spans the full width again and the scene goes back to being
     a full-bleed backdrop behind it. */
  .hero :global(.ml-scene) {
    inset: 0 0 0 auto;
    width: 52%;
    /* The scene's warm haze would otherwise end in a hard vertical line at the
       canvas edge; feather it into the hero background instead. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 24%);
    mask-image: linear-gradient(90deg, transparent, #000 24%);
  }

  @media (max-width: 900px) {
    .hero :global(.ml-scene) {
      inset: 0;
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  .hero__copy {
    max-width: 820px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 30px;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(178, 35, 25, 0.14);
    border: 1px solid rgba(224, 86, 74, 0.32);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ml-blush);
  }

  .hero__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ml-flame);
    animation: mlPulse 2.4s infinite;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    /* Sized so "Lights. Camera." (~9.2em in Lemon Milk) always fits the copy
       column on one row. */
    font-size: clamp(26px, 4.9vw, 71px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
    color: var(--ml-ink-hi);
    text-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  /* A slow spotlight glint sweeps across the caps — lantern light passing
     over marquee lettering. The base position shows the plain ink colour, so
     with animations disabled the line simply reads white. */
  .hero__caps {
    color: transparent;
    background-image: linear-gradient(
      105deg,
      var(--ml-ink-hi) 0%,
      var(--ml-ink-hi) 40%,
      #ffd9c4 47%,
      #ffffff 50%,
      #ffd9c4 53%,
      var(--ml-ink-hi) 60%,
      var(--ml-ink-hi) 100%
    );
    background-size: 320% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    animation: mlShine 5.6s ease-in-out 1.2s infinite;
  }

  @keyframes mlShine {
    /* Long hold, then one pass — a glint, not a strobe. */
    0%,
    52% {
      background-position: 100% 0;
    }
    100% {
      background-position: 0% 0;
    }
  }

  /* The payoff word abandons the uppercase system: a sweeping fashion italic
     against the towering caps is the one deliberate glamour moment. The stack
     is an inline grid so every word occupies the same slot and the layout
     never jumps as they trade places. */
  .hero__rotate {
    display: inline-grid;
    white-space: nowrap;
  }

  .hero__word {
    grid-area: 1 / 1;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ml-flame);
    opacity: 0;
    transform: translateY(0.3em);
    filter: blur(7px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .hero__word.is-active {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .hero__word.is-leaving {
    opacity: 0;
    transform: translateY(-0.3em);
    filter: blur(7px);
  }

  .hero__lede {
    max-width: 600px;
    margin: 28px 0 40px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    pointer-events: auto;
  }

  /* Staggered entrance for the hero stack. */
  .heroIn {
    opacity: 0;
    animation: mlUp 0.9s var(--ease-out) forwards;
  }

  .hero__title.heroIn {
    animation-delay: 0.08s;
  }

  .hero__lede.heroIn {
    animation-delay: 0.16s;
  }

  .hero__actions.heroIn {
    animation-delay: 0.24s;
  }

  /* Partner credit. Deliberately quiet — it sits below the calls to action and
     must not compete with them for attention. */
  .partner {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(22px, 3.2vh, 38px);
    padding: 8px 18px 8px 0;
    border-radius: 999px;
    pointer-events: auto;
    color: var(--ml-muted);
    transition: color 0.2s, opacity 0.2s;
  }

  .partner:hover {
    color: var(--ml-ink);
  }

  .partner__label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
