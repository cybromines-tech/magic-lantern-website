---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { team } from '../data/team';

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  title="Team"
  description="The people behind the camera, the keyboard and the campaign."
  active="team"
>
  <PageHero
    eyebrow="The crew"
    title="Team"
    lede="The people behind the camera, the keyboard and the campaign."
  />

  <!-- INTRO -->
  <section class="intro">
    <div class="shell intro__inner">
      <div class="intro__lead">
        <p class="eyebrow" data-reveal>Faces</p>
        <p class="intro__text" data-reveal>
          Scripting, shooting, designing and marketing all happen under one roof — which only
          works because of the people doing it. Writers, shooters, editors, designers and
          marketers, in the room together from the first idea to the final cut.
        </p>
      </div>
      <p class="intro__count" data-reveal>
        <span class="intro__num">{team.length}</span>
        <span class="intro__label">people<br />one roof</span>
      </p>
    </div>
  </section>

  <!-- ROSTER -->
  <section class="roster">
    <div class="shell">
      <ul class="roster__grid">
        {
          team.map((m, i) => (
            <li class="member" data-reveal>
              <article class="member__frame">
                <img
                  class="member__img"
                  src={`/assets/team/${m.slug}.webp`}
                  srcset={`/assets/team/${m.slug}-sm.webp 390w, /assets/team/${m.slug}.webp 780w`}
                  sizes="(max-width: 620px) 92vw, (max-width: 1000px) 44vw, (max-width: 1360px) 30vw, 300px"
                  width="780"
                  height="1040"
                  alt={`${m.name} — ${m.role}`}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                {/* Two blend layers turn every photo into the same warm duotone at
                    rest, so a studio white background and a monsoon hillside sit in
                    one wall together. Both fade out on hover. */}
                <span class="member__tint" aria-hidden="true" />
                <span class="member__lift" aria-hidden="true" />
                <span class="member__scrim" aria-hidden="true" />

                <span class="member__index" aria-hidden="true">
                  {num(i)}
                </span>

                <div class="member__meta">
                  <span class="member__rule" aria-hidden="true" />
                  <h2 class="member__name">{m.name}</h2>
                  <p class="member__role">{m.role}</p>
                </div>
              </article>
            </li>
          ))
        }

        {/* Closes the roster with an open invitation. */}
        <li class="member" data-reveal>
          <a class="member__frame joinCard" href="/contact">
            <span class="joinCard__plus" aria-hidden="true">+</span>
            <span class="joinCard__title">Join the crew</span>
            <span class="joinCard__note">
              We are always looking for people who can tell a story.
            </span>
            <span class="joinCard__cta">Say hello →</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ORIGIN BAND -->
  <section class="origin">
    <div class="shell">
      <figure class="origin__figure" data-reveal>
        <figcaption class="origin__copy">
          <span class="eyebrow">How it started</span>
          <p class="origin__text">{site.founded}</p>
          <p class="origin__sub">
            Our journey began with a shared vision to illuminate stories that inspire, educate
            and entertain.
          </p>
        </figcaption>
        <div class="origin__media">
          <img
            class="origin__img"
            src="/assets/team/crew.webp"
            width="1300"
            height="650"
            alt="Three of the Magic Lantern crew together in the early days."
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <CtaBand script="want in on it?" lines={['Bring us', 'your story']} />
</Base>

<style>
  /* --- Intro ---------------------------------------------------------------- */

  .intro {
    padding-block: var(--section-y);
    background: var(--ml-bg);
  }

  .intro__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  .intro__lead {
    max-width: 720px;
  }

  .intro__text {
    font-size: clamp(11.5px, 1.2vw, 13.5px);
    line-height: 1.75;
    color: var(--ml-text);
    margin: 0;
  }

  .intro__count {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
  }

  .intro__num {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(46px, 6.4vw, 88px);
    line-height: 0.86;
    color: var(--ml-flame);
  }

  .intro__label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--ml-dim);
  }

  /* --- Roster grid ---------------------------------------------------------- */

  .roster {
    padding-bottom: var(--section-y);
    background: var(--ml-bg);
  }

  .roster__grid {
    --stagger: clamp(22px, 3.4vw, 56px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 1.9vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The offset runs down every second column, so the wall reads as two
     interleaved rhythms rather than a spreadsheet. Each breakpoint restates
     both the reset and the offset, because the column count changes which
     children sit in an offset column. */
  .member {
    margin-top: 0;
  }

  .member:nth-child(2n) {
    margin-top: var(--stagger);
  }

  .member__frame {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    /* Contains the blend layers, so they can never reach the page behind. */
    isolation: isolate;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--ml-surface);
    transition: transform 0.5s var(--ease-out), border-color 0.4s, box-shadow 0.5s var(--ease-out);
  }

  .member__frame:hover {
    transform: translateY(-6px);
    border-color: rgba(224, 86, 74, 0.55);
    box-shadow: 0 26px 60px -28px rgba(0, 0, 0, 0.9);
  }

  .member__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition: filter 0.6s var(--ease-out), transform 0.9s var(--ease-out);
  }

  .member__frame:hover .member__img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.05);
  }

  /* multiply pulls the highlights down into the flame */
  .member__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(155deg, #e0564a 0%, #b22319 58%, #7c130f 100%);
    mix-blend-mode: multiply;
    opacity: 0.42;
    transition: opacity 0.6s var(--ease-out);
  }

  /* screen lifts the crushed blacks back to a warm plum */
  .member__lift {
    position: absolute;
    inset: 0;
    background: #241419;
    mix-blend-mode: screen;
    opacity: 0.34;
    transition: opacity 0.6s var(--ease-out);
  }

  .member__frame:hover .member__tint,
  .member__frame:hover .member__lift {
    opacity: 0;
  }

  .member__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 12, 0.34) 0%, transparent 32%, transparent 46%, rgba(10, 10, 12, 0.92) 100%);
    pointer-events: none;
  }

  .member__index {
    position: absolute;
    top: 16px;
    left: 18px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--ml-blush);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }

  .member__meta {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    pointer-events: none;
  }

  .member__rule {
    display: block;
    width: 22px;
    height: 2px;
    margin-bottom: 12px;
    border-radius: 2px;
    background: var(--ml-flame);
    transform-origin: left;
    transition: width 0.5s var(--ease-out);
  }

  .member__frame:hover .member__rule {
    width: 54px;
  }

  .member__name {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(12px, 1.15vw, 14.5px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 6px;
    color: #fff;
  }

  .member__role {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
    color: var(--ml-blush);
  }

  /* --- Join card ------------------------------------------------------------ */

  .joinCard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 8px;
    padding: 22px;
    border-style: dashed;
    border-color: rgba(224, 86, 74, 0.34);
    background: radial-gradient(130% 110% at 22% 12%, rgba(178, 35, 25, 0.3), transparent 62%),
      var(--ml-surface);
  }

  .joinCard:hover {
    border-color: rgba(224, 86, 74, 0.7);
  }

  .joinCard__plus {
    margin-bottom: auto;
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1;
    color: var(--ml-flame);
    transition: transform 0.5s var(--ease-out);
  }

  .joinCard:hover .joinCard__plus {
    transform: rotate(90deg);
  }

  .joinCard__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(12px, 1.15vw, 14.5px);
    text-transform: uppercase;
    color: var(--ml-ink-hi);
  }

  .joinCard__note {
    font-family: var(--font-ui);
    font-size: 10px;
    line-height: 1.65;
    color: var(--ml-dim);
  }

  .joinCard__cta {
    margin-top: 6px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ml-flame);
  }

  /* --- Origin band ---------------------------------------------------------- */

  .origin {
    padding-bottom: var(--section-y);
    background: var(--ml-bg);
  }

  /* Copy sits beside the photograph rather than on top of it — the group shot
     puts three faces right where an overlaid caption would land. */
  .origin__figure {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: stretch;
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--ml-line);
    background: radial-gradient(120% 140% at 12% 12%, #2a1614 0%, var(--ml-surface) 58%);
  }

  .origin__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 3.6vw, 52px);
  }

  .origin__text {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: clamp(13px, 1.6vw, 19px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    color: var(--ml-ink-hi);
  }

  .origin__sub {
    font-size: clamp(11px, 1.1vw, 12.5px);
    line-height: 1.75;
    color: var(--ml-muted);
    margin: 0;
  }

  .origin__media {
    position: relative;
    min-height: clamp(220px, 28vw, 380px);
  }

  .origin__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 34%;
    filter: grayscale(0.3) contrast(1.05);
  }

  /* --- Breakpoints ---------------------------------------------------------- */

  @media (max-width: 1000px) {
    .roster__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .member {
      margin-top: 0;
    }

    .member:nth-child(3n + 2) {
      margin-top: var(--stagger);
    }
  }

  @media (max-width: 860px) {
    .origin__figure {
      grid-template-columns: 1fr;
    }

    /* Photo first when stacked, so the section still opens on an image. */
    .origin__copy {
      order: 2;
    }
  }

  @media (max-width: 720px) {
    .roster__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .member {
      margin-top: 0;
    }

    .member:nth-child(2n) {
      margin-top: var(--stagger);
    }

    .intro__inner {
      align-items: flex-start;
    }
  }

  /* Two columns hold all the way down to the narrowest phones — a single
     column would turn a dozen 3:4 cards into a 5,000px scroll. */
  @media (max-width: 359px) {
    .roster__grid {
      grid-template-columns: 1fr;
    }

    .member,
    .member:nth-child(2n) {
      margin-top: 0;
    }
  }

  /* Nothing hovers on touch, so the duotone would be permanent — these get the
     photographs in full colour from the start. */
  @media (hover: none) {
    .member__img {
      filter: none;
    }

    .member__tint,
    .member__lift {
      opacity: 0;
    }
  }
</style>
