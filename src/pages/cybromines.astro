---
import Base from '../layouts/Base.astro';
import {
  cybromines,
  cybrominesServices,
  cybrominesStats,
  cybrominesSystems,
} from '../data/cybromines';
import { site } from '../data/site';
---

<Base
  title="Cybromines"
  description={`${cybromines.name} is Magic Lantern's software development partner — an ${cybromines.positioning} building ERP, CRM, POS, inventory, production, property and queue systems.`}
  active="cybromines"
>
  <!-- HERO -->
  <section class="chero">
    <div class="chero__glow" aria-hidden="true"></div>
    <div class="shell chero__inner">
      <p class="chero__eyebrow heroIn">
        <span class="chero__pip" aria-hidden="true"></span>
        Magic Lantern&rsquo;s software development partner
      </p>

      <div class="chero__lockup heroIn">
        <img
          class="chero__logo"
          src="/assets/cybromines-logo.png"
          alt="Cybromines — Invention is our Innovation"
          width="543"
          height="405"
        />
      </div>

      <h1 class="chero__title heroIn">{cybromines.headline}</h1>
      <p class="chero__lede heroIn">{cybromines.subheadline}</p>

      <div class="chero__actions heroIn">
        <a href={cybromines.url} target="_blank" rel="noopener" class="btn btn--cybro">
          Visit cybromines.com ↗
        </a>
        <a href="/contact" class="btn btn--ghost">Brief us together</a>
      </div>
    </div>
  </section>

  <!-- THE PARTNERSHIP -->
  <section class="pact">
    <div class="shell shell--narrow">
      <p class="eyebrow eyebrow--cybro" data-reveal>How it works</p>
      <p class="pact__statement" data-reveal>{cybromines.relationship}</p>

      <div class="pact__split">
        <div class="pact__side" data-reveal>
          <span class="pact__who pact__who--ml">Magic Lantern</span>
          <span class="pact__does">
            Story, brand and campaign. Scripting, film, photography, identity and the
            marketing that carries it.
          </span>
        </div>
        <div class="pact__side" data-reveal>
          <span class="pact__who pact__who--cybro">Cybromines</span>
          <span class="pact__does">
            The software underneath. Platforms, integrations and AI agents — built to run
            the operation, not just demo well.
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="cstats">
    <div class="shell shell--narrow cstats__grid">
      {
        cybrominesStats.map((s) => (
          <div class="cstat" data-reveal>
            <span class="cstat__value">{s.value}</span>
            <span class="cstat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SYSTEMS -->
  <section class="systems">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--cybro" data-reveal>The platform</p>
          <h2 class="display" data-reveal>Seven systems,<br />one platform</h2>
        </div>
        <a href={cybromines.url} target="_blank" rel="noopener" class="link-arrow link-arrow--cybro" data-reveal>
          See them in detail ↗
        </a>
      </div>

      <div class="systems__grid">
        {
          cybrominesSystems.map((s) => (
            <article class="scard" data-reveal>
              <span class="scard__num">{s.num}</span>
              <h3 class="scard__title">{s.title}</h3>
              <p class="scard__desc">{s.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="cservices">
    <div class="shell">
      <p class="eyebrow eyebrow--cybro" data-reveal>Beyond the platform</p>
      <h2 class="display cservices__title" data-reveal>What else they build</h2>

      <div class="cservices__grid">
        {
          cybrominesServices.map((s) => (
            <article class="srow" data-reveal>
              <h3 class="srow__title">{s.title}</h3>
              <p class="srow__desc">{s.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ccta">
    <div class="ccta__inner" data-reveal>
      <div class="ccta__logo">
        <img
          class="ccta__logoimg"
          src="/assets/cybromines-logo.png"
          alt="Cybromines"
          width="543"
          height="405"
          loading="lazy"
          decoding="async"
        />
      </div>
      <h2 class="ccta__title">Need the software as well as the story?</h2>
      <p class="ccta__lede">
        Brief Magic Lantern and Cybromines together and the campaign and the system that
        runs it get designed in the same room.
      </p>
      <div class="ccta__actions">
        <a href="/contact" class="btn btn--flame">Start a project</a>
        <a href={cybromines.url} target="_blank" rel="noopener" class="btn btn--cybro">
          cybromines.com ↗
        </a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn--ghost">
          Chat on WhatsApp
        </a>
      </div>

      <ul class="ccta__socials">
        {
          cybromines.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                {s.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* This page carries Cybromines' violet→cyan rather than Magic Lantern's
     crimson, so it is unmistakably a different company inside the same shell. */
  .chero,
  .pact,
  .cstats,
  .systems,
  .cservices,
  .ccta {
    --cybro-a: #7c3aed;
    --cybro-b: #22d3ee;
    --cybro-soft: #a78bfa;
  }

  /* --- Hero --------------------------------------------------------------- */

  .chero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 78vh;
    overflow: hidden;
    background: radial-gradient(120% 100% at 78% 12%, #1e1444 0%, #14161f 46%, #0f1012 100%);
  }

  .chero__glow {
    position: absolute;
    top: -220px;
    right: -140px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.3), transparent 66%);
    pointer-events: none;
  }

  .chero__inner {
    position: relative;
    padding-block: 150px clamp(56px, 7vw, 92px);
  }

  .chero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 30px;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(124, 58, 237, 0.14);
    border: 1px solid rgba(124, 58, 237, 0.34);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cbb6fb;
  }

  .chero__pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
    background: linear-gradient(135deg, var(--cybro-a), var(--cybro-b));
  }

  .chero__lockup {
    margin-bottom: 26px;
  }

  .chero__logo {
    display: block;
    width: auto;
    height: clamp(120px, 16vw, 190px);
  }

  .chero__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(30px, 4.6vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 17ch;
    color: var(--ml-ink-hi);
  }

  .chero__lede {
    max-width: 640px;
    margin: 24px 0 0;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.7;
    color: var(--ml-text);
  }

  .chero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .heroIn {
    opacity: 0;
    animation: mlUp 0.9s var(--ease-out) forwards;
  }

  .chero__lockup.heroIn {
    animation-delay: 0.06s;
  }
  .chero__title.heroIn {
    animation-delay: 0.12s;
  }
  .chero__lede.heroIn {
    animation-delay: 0.18s;
  }
  .chero__actions.heroIn {
    animation-delay: 0.24s;
  }

  @media (prefers-reduced-motion: reduce) {
    .heroIn {
      opacity: 1;
      animation: none;
    }
  }

  /* --- Shared accents ----------------------------------------------------- */

  .eyebrow--cybro {
    color: var(--cybro-soft);
  }

  .link-arrow--cybro {
    color: var(--cybro-soft);
    border-bottom-color: rgba(167, 139, 250, 0.4);
  }

  .link-arrow--cybro:hover {
    color: #d5c6fd;
    border-bottom-color: var(--cybro-soft);
  }

  .btn--cybro {
    color: #fff;
    background: linear-gradient(135deg, var(--cybro-a), #4f46e5);
    box-shadow: 0 18px 40px -14px rgba(124, 58, 237, 0.9);
  }

  .btn--cybro:hover {
    color: #fff;
    transform: translateY(-2px);
    filter: brightness(1.12);
  }

  /* --- Partnership -------------------------------------------------------- */

  .pact {
    position: relative;
    padding-block: var(--section-y);
    background: var(--ml-bg-alt);
  }

  .pact__statement {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: clamp(22px, 2.9vw, 38px);
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--ml-ink);
    margin: 0 0 56px;
    max-width: 900px;
  }

  .pact__split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .pact__side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px 28px;
    border-radius: 18px;
    background: var(--ml-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pact__who {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pact__who--ml {
    color: var(--ml-flame);
  }

  .pact__who--cybro {
    background: linear-gradient(135deg, var(--cybro-soft), var(--cybro-b));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pact__does {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ml-muted);
  }

  /* --- Stats -------------------------------------------------------------- */

  .cstats {
    padding-block: clamp(52px, 6vw, 84px);
    background: linear-gradient(180deg, #0f1012, #141032);
    border-top: 1px solid var(--ml-line-soft);
    border-bottom: 1px solid var(--ml-line-soft);
  }

  .cstats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 32px;
    text-align: center;
  }

  .cstat__value {
    display: block;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--cybro-soft), var(--cybro-b));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cstat__label {
    display: block;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13.5px;
    color: #b8b9bc;
    margin-top: 12px;
  }

  /* --- Systems ------------------------------------------------------------ */

  .systems {
    padding-block: var(--section-y);
    background: var(--ml-bg-alt);
  }

  .systems__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 20px;
  }

  .scard {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px 28px;
    border-radius: 18px;
    background: var(--ml-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s var(--ease-out), border-color 0.3s, background 0.3s;
  }

  .scard:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 58, 237, 0.5);
    background: var(--ml-surface-hi);
  }

  .scard__num {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    background: linear-gradient(135deg, var(--cybro-soft), var(--cybro-b));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .scard__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 21px;
    color: var(--ml-ink);
    margin: 0;
  }

  .scard__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ml-muted);
    margin: 0;
  }

  /* --- Services ----------------------------------------------------------- */

  .cservices {
    padding-block: var(--section-y);
    background: var(--ml-bg);
  }

  .cservices__title {
    margin-bottom: 48px;
  }

  .cservices__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--ml-line);
    border: 1px solid var(--ml-line);
    border-radius: 18px;
    overflow: hidden;
  }

  .srow {
    background: var(--ml-surface);
    padding: 32px 26px;
    min-height: 190px;
  }

  .srow__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 19px;
    color: var(--ml-ink);
    margin: 0 0 12px;
  }

  .srow__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ml-muted);
    margin: 0;
  }

  /* --- CTA ---------------------------------------------------------------- */

  .ccta {
    position: relative;
    padding: clamp(72px, 9vw, 132px) var(--gutter);
    background: radial-gradient(120% 130% at 75% 18%, #3b1d8f 0%, #1c1546 42%, #0d0b18 100%);
    overflow: hidden;
  }

  .ccta__inner {
    position: relative;
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }

  .ccta__logo {
    display: flex;
    justify-content: center;
    margin-bottom: 26px;
  }

  .ccta__logoimg {
    display: block;
    width: auto;
    height: clamp(90px, 12vw, 130px);
  }

  .ccta__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 54px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: #fff;
  }

  .ccta__lede {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.7;
    color: #cfc7e8;
    margin: 0 auto 32px;
    max-width: 600px;
  }

  .ccta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  .ccta__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    justify-content: center;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .ccta__socials a {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13.5px;
    color: #b7a9e0;
    transition: color 0.2s;
  }

  .ccta__socials a:hover {
    color: #fff;
  }
</style>
